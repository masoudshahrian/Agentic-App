# Copy to .env and fill in your own key. Never commit .env (it is git-ignored).
# Create a key at https://openrouter.ai/keys (see README, "Quick start from zero").
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key

# Default is a free model: no payment needed, but often rate limited (HTTP 429).
# For reliable use switch to the paid model below (needs a few dollars of OpenRouter credit).
LLM_MODEL=google/gemma-4-31b-it:free
# LLM_MODEL=google/gemma-4-31b-it

# Optional
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_RETRIES=4
